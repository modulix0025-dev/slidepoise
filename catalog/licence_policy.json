{
  "version": 1,
  "decided": "2026-10-11",
  "rule": "No component that is dual-licensed with a paid commercial licence, sold, fee-gated for commercial users, or non-commercial may ship in the Studio or be its default.",
  "print_asset_allowlist": ["CC0-1.0", "PDM", "MIT", "ISC", "BSD-2-Clause", "BSD-3-Clause", "Apache-2.0", "OFL-1.1", "CC-BY-4.0"],
  "print_asset_requires_credits": ["CC-BY-4.0"],
  "print_asset_refused": ["CC-BY-SA-3.0", "CC-BY-SA-4.0", "CC-BY-NC-4.0", "CC-BY-NC-SA-4.0", "CC-BY-ND-4.0", "CC-BY-NC-ND-4.0", "GPL-2.0-only", "GPL-2.0-or-later", "GPL-3.0", "GPL-3.0-or-later", "MPL-2.0", "UNKNOWN", "personal-use"],
  "print_asset_pending_operator": ["Unlicense", "CC-BY-3.0"],
  "model_weight_allowlist": ["Apache-2.0", "MIT"],
  "banned_components": [
    {"id": "ghostscript", "patterns": ["ghostscript", "gswin64c", "gswin32c", "gsdll"], "reason": "AGPL-3.0 or Artifex paid commercial licence", "replacement": "pikepdf + LittleCMS + pypdfium2 + colord CC0 profiles"},
    {"id": "mupdf", "patterns": ["pymupdf", "fitz", "mupdf"], "reason": "AGPL-3.0 or Artifex paid commercial licence", "replacement": "pypdfium2 / pikepdf"},
    {"id": "inno-setup", "patterns": ["iscc.exe", "[setup]\nappid="], "reason": "author requests a paid licence for commercial use", "replacement": "NSIS 3"},
    {"id": "wix-6plus", "patterns": ["wixtoolset.sdk"], "reason": "Open Source Maintenance Fee for revenue-earning users", "replacement": "NSIS 3"},
    {"id": "flux-dev", "patterns": ["flux.1-dev", "flux1-dev", "flux.1 [dev]", "kontext-dev", "flux1-kontext-dev", "kontext [dev]"], "reason": "FLUX.1 [dev] Non-Commercial License", "replacement": "Qwen-Image / Qwen-Image-Edit-2511 / FLUX.1 [schnell]"},
    {"id": "paid-search", "patterns": ["serpapi", "tavily", "api.bing.microsoft.com", "api.search.brave.com"], "reason": "paid commercial search APIs", "replacement": "Openverse + Wikimedia Commons + Iconify"},
    {"id": "remixicon-4.9+", "patterns": ["remixicon@4.9", "remixicon@5"], "reason": "Remix Icon License v1.0 forbids icon libraries", "replacement": "Remix Icon <= 4.8.0 (Apache-2.0), Tabler, Phosphor, Lucide"}
  ]
}
